{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "fileAssociations": [
      {
        "ext": ["mp3", "flac", "m4a", "m4b", "aac", "ogg", "oga", "opus", "wav", "wma", "aiff", "aif", "ape", "wv", "mka"],
        "name": "Limusic Audio",
        "description": "Audio file supported by Limusic",
        "role": "Viewer",
        "mimeType": "audio/*"
      }
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Limusic",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "transparent": false,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  }
}
